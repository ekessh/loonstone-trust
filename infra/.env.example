# Copy to infra/.env and fill in. infra/.env is git-ignored.
# Generate every secret yourself, for example: python -c "import secrets; print(secrets.token_hex(32))"
# Never keep an upstream default (CHANGEME, mysecret). scripts/check_infra.py checks this.

# Langfuse (infra/compose.langfuse.yml), http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
SALT=
# 64 hex characters
ENCRYPTION_KEY=
TELEMETRY_ENABLED=false
POSTGRES_PASSWORD=
# Same password as POSTGRES_PASSWORD
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/postgres
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
# Same value as MINIO_ROOT_PASSWORD
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://localhost:9190
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=http://localhost:9190

# Langfuse first login and project. The project keys go into the root .env
# as LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY.
LANGFUSE_INIT_ORG_ID=loonstone
LANGFUSE_INIT_ORG_NAME="Loonstone Trust (demo)"
LANGFUSE_INIT_PROJECT_ID=renewal-caller
LANGFUSE_INIT_PROJECT_NAME="Renewal Caller"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# VerifyWise (infra/compose.verifywise.yml), http://localhost:8084
VW_DB_PASSWORD=
VW_JWT_SECRET=
VW_REFRESH_SECRET=
VW_ENCRYPTION_KEY=
VW_EVAL_INTERNAL_KEY=
VW_GATEWAY_INTERNAL_KEY=
# Superadmin: platform setup only, belongs to no organisation
VW_ADMIN_EMAIL=aims@loonstone.local
VW_ADMIN_PASSWORD=
# Accountable owner (Admin): approves risks
VW_ORG_ADMIN_EMAIL=
VW_ORG_ADMIN_PASSWORD=
# Engineer (Editor): enters and owns risks
VW_ENGINEER_EMAIL=
VW_ENGINEER_PASSWORD=

# LiveKit (infra/compose.livekit.yml), ws://localhost:7880
# Same key and secret as in the root .env
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
