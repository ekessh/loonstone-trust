# Copy to .env and fill in. .env is git-ignored.

# Agent dialogue model
ANTHROPIC_API_KEY=

# Speech-to-text and text-to-speech (agent and simulator)
DEEPGRAM_API_KEY=

# Borrower simulator model. Set the data policy to exclude providers that train on prompts.
OPENROUTER_API_KEY=

# Tracing (local Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Local LiveKit server (same key and secret as in infra/.env)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=generate-one: LT plus random hex
LIVEKIT_API_SECRET=generate-one: at least 32 random characters

# Optional: default agent version when a call doesn't name one (v0.9 or v1.0)
RENEWAL_AGENT_VERSION=v1.0
